# SPDX-License-Identifier: GPL-2.0
# WolKernel (linux-wolos): Kconfig fragment applied over Arch's x86_64 config, then `make olddefconfig`.
# Rule: anything that runs on stock Arch runs here. Datacenter/cluster hardware, pre-2010 PC buses and two
# unused ABIs go (x32, vsyscall). Kept on purpose: IA32 (32-bit Steam), modify_ldt, 16-bit segments and
# binfmt_misc (Wine), ioperm, UID16, SysV IPC, futex_waitv, ntsync, io_uring, seccomp/landlock, user namespaces,
# overlayfs/cgroup v2/nftables/veth/bridge (Docker, Podman, Flatpak), KVM, Xen/Hyper-V/VMware guests, BPF/BTF.

# Identity: modules in /lib/modules/<ver>-wolos; the package build sets uname -v to "WolKernel <ver> (<linux>)" from kernel/VERSION.
CONFIG_LOCALVERSION="-wolos"
# CONFIG_LOCALVERSION_AUTO is not set
# WolOS hint interface (/sys/kernel/wolos), present when the extra patches are applied.
CONFIG_WOLOS_HINTS=y

# Module ABI: symbol CRCs, so vendor modules (NVIDIA, ZFS, v4l2loopback) built for one release keep loading.
CONFIG_MODVERSIONS=y
CONFIG_GENKSYMS=y

# Latency: full preemption, 1000 Hz tick, idle-only tickless (NO_HZ_FULL taxes every syscall on desktops).
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_NO_HZ_FULL is not set
CONFIG_NO_HZ_IDLE=y
# Scheduler: sched_ext loads the WolOS scheduler; EEVDF takes over if it exits. Needs BPF JIT and BTF.
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PSI=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# Memory: hugepages only where apps ask (no compaction stalls), MGLRU on, zram + zswap with zstd.
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
# zram (zram-generator in the image) is the swap: zswap stays available but off, or it would compress twice.
# CONFIG_ZSWAP_DEFAULT_ON is not set
# Sizing: no desktop has more than 512 CPU threads; per-CPU tables shrink (Arch builds for 8192).
CONFIG_NR_CPUS=512
# Network: BBR is the default congestion control (better on Wi-Fi and lossy links).
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_NET_SCH_FQ=y
# Gaming: ntsync for Wine/Proton (futex_waitv is always built).
CONFIG_NTSYNC=m

# Userspace ABI removed (list: kernel/abi-removed.txt). x32: no x32 userland exists in Arch, Flatpak, Docker images or Steam.
# CONFIG_X86_X32_ABI is not set
# vsyscall page: only glibc < 2.14 (2011) static binaries call it; Steam, Proton and the Steam runtime do not.
# Boot with vsyscall=xonly to bring it back for one machine.
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_LEGACY_VSYSCALL_XONLY is not set
# Pre-ACPI MP tables (pre-2005 boards); ACPI MADT describes every CPU WolOS supports.
# CONFIG_X86_MPPARSE is not set

# Debug: keep BTF (sched_ext), ftrace/kprobes (perf, bpftrace); drop in-kernel test suites.
# CONFIG_KUNIT is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

# Telephony and radio links no PC has: ISDN, ATM, amateur radio, FDDI, HIPPI.
# CONFIG_ISDN is not set
# CONFIG_ATM is not set
# CONFIG_HAMRADIO is not set
# CONFIG_FDDI is not set
# CONFIG_HIPPI is not set
# Datacenter storage: InfiniBand/RDMA, Fibre Channel/FCoE, SCSI/NVMe targets, legacy RAID cards, Fusion MPT.
# LSI/Broadcom SAS (mpt3sas, megaraid_sas), virtio-scsi, VMware/Hyper-V storage, AHCI, NVMe, USB/UAS stay.
# CONFIG_INFINIBAND is not set
# CONFIG_FUSION is not set
# CONFIG_TARGET_CORE is not set
# CONFIG_NVME_TARGET is not set
# CONFIG_ATA_OVER_ETH is not set
# CONFIG_SCSI_CXGB3_ISCSI is not set
# CONFIG_SCSI_CXGB4_ISCSI is not set
# CONFIG_SCSI_BNX2_ISCSI is not set
# CONFIG_SCSI_BNX2X_FCOE is not set
# CONFIG_BLK_DEV_3W_XXXX_RAID is not set
# CONFIG_SCSI_3W_9XXX is not set
# CONFIG_SCSI_3W_SAS is not set
# CONFIG_SCSI_ACARD is not set
# CONFIG_SCSI_AIC7XXX is not set
# CONFIG_SCSI_AIC79XX is not set
# CONFIG_SCSI_AIC94XX is not set
# CONFIG_SCSI_MVSAS is not set
# CONFIG_SCSI_MVUMI is not set
# CONFIG_SCSI_ADVANSYS is not set
# CONFIG_SCSI_ARCMSR is not set
# CONFIG_SCSI_ESAS2R is not set
# CONFIG_MEGARAID_NEWGEN is not set
# CONFIG_MEGARAID_LEGACY is not set
# CONFIG_SCSI_MPI3MR is not set
# CONFIG_SCSI_HPTIOP is not set
# CONFIG_SCSI_BUSLOGIC is not set
# CONFIG_SCSI_MYRB is not set
# CONFIG_SCSI_MYRS is not set
# CONFIG_SCSI_SNIC is not set
# CONFIG_SCSI_DMX3191D is not set
# CONFIG_SCSI_FDOMAIN_PCI is not set
# CONFIG_SCSI_ISCI is not set
# CONFIG_SCSI_IPS is not set
# CONFIG_SCSI_INITIO is not set
# CONFIG_SCSI_INIA100 is not set
# CONFIG_SCSI_STEX is not set
# CONFIG_SCSI_SYM53C8XX_2 is not set
# CONFIG_SCSI_IPR is not set
# CONFIG_SCSI_QLOGIC_1280 is not set
# CONFIG_SCSI_QLA_FC is not set
# CONFIG_SCSI_QLA_ISCSI is not set
# CONFIG_SCSI_LPFC is not set
# CONFIG_SCSI_EFCT is not set
# CONFIG_SCSI_AM53C974 is not set
# CONFIG_SCSI_WD719X is not set
# CONFIG_SCSI_DEBUG is not set
# CONFIG_SCSI_PMCRAID is not set
# CONFIG_SCSI_PM8001 is not set
# CONFIG_SCSI_BFA_FC is not set
# CONFIG_SCSI_CHELSIO_FCOE is not set
# Datacenter NICs (Chelsio, QLogic, Emulex, Huawei, Solarflare, Cavium, Pensando, Netronome, Azure MANA, Fungible,
# Brocade, Myricom). Intel 10/25G and Mellanox ConnectX stay: they show up in workstations.
# CONFIG_NET_VENDOR_CHELSIO is not set
# CONFIG_NET_VENDOR_QLOGIC is not set
# CONFIG_NET_VENDOR_EMULEX is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_SOLARFLARE is not set
# CONFIG_NET_VENDOR_CAVIUM is not set
# CONFIG_NET_VENDOR_PENSANDO is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
# CONFIG_NET_VENDOR_MICROSOFT is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_NET_VENDOR_BROCADE is not set
# CONFIG_NET_VENDOR_MYRI is not set
# Cluster and server filesystems (cluster locking, parallel FS, zoned drives); every desktop, removable and
# foreign-OS filesystem stays (btrfs, ext4, xfs, f2fs, vfat, exfat, ntfs3, hfs/hfs+, ufs, iso9660, udf, jfs, nilfs2).
# CONFIG_OCFS2_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_DLM is not set
# CONFIG_ORANGEFS_FS is not set
# CONFIG_ZONEFS_FS is not set
# CONFIG_OMFS_FS is not set
# CONFIG_BEFS_FS is not set

# Pre-2010 PC buses and ports: PCMCIA/CardBus, floppy controller, parallel port, gameport.
# USB floppies (usb-storage), USB printers (usblp, CUPS) and USB gamepads stay.
# CONFIG_PCCARD is not set
# CONFIG_PCMCIA is not set
# CONFIG_YENTA is not set
# CONFIG_BLK_DEV_FD is not set
# CONFIG_PARPORT is not set
# CONFIG_GAMEPORT is not set
# Legacy framebuffers: simpledrm takes the firmware framebuffer (EFI/VESA) until the GPU driver loads.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# CONFIG_FB_VESA is not set
# CONFIG_FB_EFI is not set
# Old or cluster network protocols: Nokia modem pipes, 802.15.4 radios, RDS/TIPC cluster sockets, AFS/RxRPC,
# switch chips on embedded boards. NFC, CAN, Bluetooth, SCTP and every VPN stay.
# CONFIG_PHONET is not set
# CONFIG_IEEE802154 is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_AFS_FS is not set
# CONFIG_AF_RXRPC is not set
# CONFIG_NET_DSA is not set
# PCI NICs from the 1990s (DEC Tulip, 3Com, NE2000 clones, Xircom); no laptop or board since 2005 has one.
# CONFIG_NET_VENDOR_DEC is not set
# CONFIG_NET_VENDOR_3COM is not set
# CONFIG_NET_VENDOR_8390 is not set
# CONFIG_NET_VENDOR_XIRCOM is not set
# Embedded and obsolete filesystems: raw-flash (JFFS2, UBIFS), ROM images (cramfs, romfs), Coda, Minix, Amiga.
# EROFS (Android images, composefs), squashfs, iso9660, udf, HFS/HFS+ stay.
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_CRAMFS is not set
# CONFIG_ROMFS_FS is not set
# CONFIG_CODA_FS is not set
# CONFIG_MINIX_FS is not set
# CONFIG_AFFS_FS is not set

# Root is btrfs (A/B slots, ADR 0016): built in, no initramfs module needed to mount it.
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# wolos-next: patches carried on this branch (README.wolos.md, Patches).
# Network: BBRv3 beside upstream BBR, fq qdisc by default, MPTCP and WireGuard built in.
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_MPTCP=y
CONFIG_WIREGUARD=y
# Scheduling and memory: CachyOS desktop defaults (EEVDF slice, MGLRU min_ttl, no watermark boost or proactive
# compaction, split-lock throttling off), BORE on top of EEVDF, ADIOS as default I/O scheduler.
CONFIG_CACHY=y
CONFIG_SCHED_BORE=y
CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y
CONFIG_HIGH_RES_TIMERS=y
# Graphics: amdgpu plane color/HDR properties for gamescope.
CONFIG_AMD_PRIVATE_COLOR=y
# Boot: parallel CPU bringup; zstd modules, no forced module signing of every module.
CONFIG_HOTPLUG_PARALLEL=y
CONFIG_MODULE_COMPRESS_ZSTD=y
# Containers (Docker, Podman, Flatpak): already on in the Arch base and kept: overlayfs, cgroup v2 + freezer,
# user namespaces, nftables + xt compat, veth/bridge/vxlan, seccomp filter (with its built-in cache), BPF LSM.
CONFIG_OVERLAY_FS=m
CONFIG_CGROUP_FREEZER=y
CONFIG_USER_NS=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NFT_COMPAT=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_VXLAN=m
# Swap: zram can recompress cold pages with a second algorithm (lz4 primary, zstd recompress, set by
# zram-generator) and write incompressible/idle pages to a backing partition. Swap-in reads one page (zram).
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_SWAP_PAGE_CLUSTER_DEFAULT=0
# Removed syscall: sysfs(2) (SVR4 filesystem-type query, unused since libc5).
# CONFIG_SYSFS_SYSCALL is not set
